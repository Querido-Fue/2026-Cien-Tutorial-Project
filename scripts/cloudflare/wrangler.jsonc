{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nthplayer-path-router",
  "main": "./nthplayer-worker.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "assets": {
    "directory": "../../project/presentation/public",
    "binding": "PRESENTATION_ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "https://jukchang.com/*",
      "zone_name": "jukchang.com"
    },
    {
      "pattern": "https://www.jukchang.com/*",
      "zone_name": "jukchang.com"
    }
  ]
}
